# Copy to .env.local (never commit .env.local).

# Google AI Studio key — server-side only. NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=

# Supabase → Project Settings → API. The anon/publishable key is safe to expose;
# RLS gives the anon role no access to any table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — server-side only. Bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public URL used for QR codes, e.g. https://reviews.example.com
# SITE_URL=

# Protects the weekly-summary cron endpoint. Any long random string.
# Vercel sends it automatically to cron jobs when set in the project.
CRON_SECRET=
